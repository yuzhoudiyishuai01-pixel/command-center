{
  "name": "command-center",
  "version": "0.2.2",
  "description": "A local, zero-dependency chat room where you dispatch work to CLI and API AI agents (DSH, Claude Code, Codex, OpenAI/Anthropic-compatible endpoints).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "command-center": "./bin/command-center.mjs"
  },
  "files": [
    "bin/",
    "server/",
    "public/",
    "scripts/",
    "seeds/",
    "docs/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "cc.config.example.json",
    "启动指挥室.cmd",
    "Login-Claude.ps1",
    "Login-Codex.ps1",
    "Test-ClaudeCodeEndpoint.ps1"
  ],
  "scripts": {
    "start": "node bin/command-center.mjs",
    "start:nologin": "node bin/command-center.mjs --no-open",
    "serve": "node server/index.mjs",
    "test": "node scripts/test-all.mjs",
    "test:selfcheck": "node scripts/selfcheck.mjs",
    "test:store": "node scripts/test-store.mjs",
    "test:retention": "node scripts/test-retention.mjs",
    "test:members": "node scripts/test-member-flow.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "check": "node scripts/check-syntax.mjs",
    "package": "node scripts/package.mjs"
  },
  "keywords": [
    "ai-agents",
    "multi-agent",
    "chat",
    "claude-code",
    "codex",
    "deepseek-harness",
    "self-hosted"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuzhoudiyishuai01-pixel/command-center.git"
  },
  "bugs": {
    "url": "https://github.com/yuzhoudiyishuai01-pixel/command-center/issues"
  },
  "homepage": "https://github.com/yuzhoudiyishuai01-pixel/command-center#readme"
}

